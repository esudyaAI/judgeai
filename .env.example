POSTGRES_USER=judgeai
POSTGRES_PASSWORD=judgeai
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judgeai

UPLOAD_DIR=/app/uploads

LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=fake (fixed sample case) is refused unless LLM_ALLOW_FAKE=true: tests only.
# DeepSeek web proxy (tokens live only in the proxy's own env file):
# LLM_PROVIDER=deepseek_web
# LLM_API_BASE=http://host.docker.internal:28090/v1
# LLM_MODEL=deepseek-v3

# Fallback provider if the primary openapi/openai gateway fails:
# LLM_FALLBACK_PROVIDER=deepseek_web
# LLM_FALLBACK_API_BASE=http://localhost:28080/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=deepseek-chat

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# Jina cloud embeddings instead of the local model (texts of public documents leave the server):
# EMBEDDING_PROVIDER=jina
# EMBEDDING_MODEL=jina-embeddings-v3
# EMBEDDING_DIM=1024
# JINA_API_KEY=
EMBEDDING_CACHE_DIR=/app/.fastembed_cache
EMBEDDING_CHUNK_SIZE=2500
EMBEDDING_MAX_CHUNKS=8

# Set false only for a local HTTP development server. Keep true with HTTPS.
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5178
